    {
      "id": "e02",
      "time_offset_ms": 46850,
      "type": "show_schema",
      "target": "sql_viewer",
      "params": {},
      "narration": "Here's our database. We've got one table called customers. It's got columns for customer ID, full name, email, signup date, last order date, and status. Think of it like a spreadsheet with one row per customer and those six columns tracking everything about them.",
