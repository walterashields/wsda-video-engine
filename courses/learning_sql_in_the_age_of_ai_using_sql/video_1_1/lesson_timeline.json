    },
    {
      "id": "e04",
      "time_offset_ms": 80366,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "bad_select_before_delete"
      },
      "narration": "So here's the scenario. You asked ChatGPT, \"Hey, clean up my inactive customers who haven't ordered in a while.\" And it gave you a DELETE query. Looks clean, looks confident. But before we blow anything up, we're gonna swap that DELETE for a SELECT, same WHERE clause, so we can peek at who's about to get removed. Think of it like checking the guest list before you kick people out of the party.",
      "transition": "new_concept",
      "clears": [],
      "phases": []
    },
    {
      "id": "e04_pause",
      "time_offset_ms": 81266,
      "type": "pause",
      "target": null,
      "params": {
        "duration": 46.0
      },
      "narration": null,
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e05",
      "time_offset_ms": 82116,
      "type": "run_query",
      "target": "sql_viewer",
      "params": {
        "query_ref": "bad_select_before_delete"
      },
      "narration": null,
      "transition": "new_concept",
      "clears": [],
      "phases": []
    },
    {
      "id": "e05_pause",
      "time_offset_ms": 83016,
      "type": "pause",
      "target": null,
      "params": {
        "duration": 3.0
      },
