      "time_offset_ms": 141933,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "why_its_wrong"
      },
      "narration": "Let's prove it. This next query adds a diagnosis column, like a doctor's note for each row, telling us whether it's actually safe to delete.",
      "transition": "new_concept",
      "clears": [
        "bad_select_before_delete"
      ],
      "phases": []
    },
