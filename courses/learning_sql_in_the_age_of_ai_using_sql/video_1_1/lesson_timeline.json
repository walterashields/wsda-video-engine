      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e06",
      "time_offset_ms": 130516,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "Three rows come back. All three are inactive. At first glance that might seem fine, but look closer. Priya Sharma's last order date is January fifteenth, twenty twenty-three. That's recent. She's inactive, sure, but she ordered just weeks past the cutoff. Deleting her means throwing away a customer who might come back. And Fatima Al-Rashid? Her last order date is completely blank, it's null. We have no idea when she last ordered. That's not \"definitely stale,\" that's \"we don't know.\" Only Amara Johnson, with a last order date of December first, twenty twenty-two, looks like someone you'd actually want to clean up. Two out of three rows here are questionable deletes.",
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e06_pause",
      "time_offset_ms": 130966,
      "type": "pause",
      "target": null,
      "params": {
        "duration": 66.0
      },
