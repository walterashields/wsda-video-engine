      "clears": [],
      "phases": []
    },
    {
      "id": "e12b",
      "time_offset_ms": 148183,
      "type": "highlight_region",
      "target": "chat_demo",
      "params": {
        "region": "response-3",
        "callout": "Learn SQL. Not because AI can't write it. Because AI can't be accountable for it."
      },
      "narration": "Look, A-I's amazing at writing S-Q-L. I use it every single day. But here's the thing nobody tells beginners. A-I isn't responsible for your data. You are. Your boss isn't going to accept \"well, ChatGPT wrote it\" as an excuse when seventy-five customers vanish from a report. You don't need to become a S-Q-L wizard. But you absolutely need to learn enough S-Q-L to read what A-I gives you and spot when it's lying to your face. That's the skill. That's the job security. Let's go learn S-Q-L.",
      "transition": "emphasis",
      "clears": [],
      "phases": []
    },
