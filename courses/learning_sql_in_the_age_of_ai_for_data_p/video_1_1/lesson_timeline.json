    },
    {
      "id": "e08b",
      "time_offset_ms": 104366,
      "type": "highlight_region",
      "target": "chat_demo",
      "params": {
        "region": "response-2",
        "callout": "75 customers vanished \u2014 no error, no warning"
      },
      "narration": "There it is. That one word, INNER instead of LEFT, silently erased seventy-five customers from the results. The A-I's query returned one hundred twelve customers. The correct query returns one hundred eighty-seven. That's forty percent of the entire customer base, just gone. And here's the terrifying part, there was no error message, no warning, no red flag. The output looked completely normal. Just a nice clean table of numbers. Completely wrong numbers.",
      "transition": "emphasis",
      "clears": [],
