    },
    {
      "id": "e12",
      "time_offset_ms": 110216,
      "type": "show_response",
      "target": "chat_demo",
      "params": {
        "text": "No! AI is a powerful SQL writing tool. But you need the skill to verify what it gives you.\n\n\ud83d\udd11 The essential skill:\n\u2022 AI writes SQL \u2192 fast, convenient\n\u2022 YOU read SQL \u2192 accurate, accountable\n\n\u274c Your boss won't accept: \"ChatGPT wrote it\"\n\u2705 Your boss will respect: \"I checked the logic myself\"\n\nYou don't need to become a SQL wizard. You need to learn enough SQL to read what AI gives you and spot when it's wrong. That's the skill. That's the job security.",
        "region": "response-3"
      },
      "narration": null,
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e12_pause",
      "time_offset_ms": 110666,
      "type": "pause",
      "target": null,
      "params": {
        "duration": 1.0
      },
      "narration": null,
