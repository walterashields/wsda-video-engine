    {
      "id": "e05b",
      "time_offset_ms": 79550,
      "type": "highlight_region",
      "target": "chat_demo",
      "params": {
        "region": "response-1",
        "callout": "No formulas \u2014 just drag and drop"
      },
      "narration": "Look at what's on screen. Your data has four columns, Date, Store, Product, and Amount. That's ten thousand rows of coffee shop sales, and it looks terrifying. But a Pivot Table doesn't care how big your data is. It just needs you to tell it two things: what to group by, and what to add up. No formulas. No filters. No tears. You're literally going to drag field names into boxes. That's the secret nobody told you.",
      "transition": "continuation",
