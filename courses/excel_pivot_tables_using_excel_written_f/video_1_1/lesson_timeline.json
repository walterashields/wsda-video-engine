      "target": "chat_demo",
      "params": {
        "text": "OK I'm ready. Walk me through it step by step. How do I actually create the Pivot Table?",
        "region": "prompt-2"
      },
      "narration": null,
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
