    {
      "id": "e08",
      "time_offset_ms": 85200,
      "type": "show_response",
      "target": "chat_demo",
      "params": {
        "text": "**Step 1 \u2014 Select & Insert**\nClick any cell inside your data. Go to Insert > Pivot Table. Click OK.\n\n**Step 2 \u2014 Drag Store into Rows**\nIn the field list on the right, drag \"Store\" into the Rows area.\n\n**Step 3 \u2014 Drag Amount into Values**\nDrag \"Amount\" into the Values area.\n\n\u2705 **Done.** You now have total sales per store. 10,000 rows summarized instantly.",
        "region": "response-2"
      },
      "narration": null,
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e08_pause",
      "time_offset_ms": 85650,
