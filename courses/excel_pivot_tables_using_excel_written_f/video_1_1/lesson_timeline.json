    },
    {
      "id": "e08b",
      "time_offset_ms": 125250,
      "type": "highlight_region",
      "target": "chat_demo",
      "params": {
        "region": "response-2",
        "callout": "Three steps \u2014 that's genuinely it"
      },
      "narration": "Three steps. I'm not exaggerating. Step one, click any cell in your data, go to Insert, click Pivot Table, click OK. Step two, you'll see a field list on the right side of your screen. Drag Store into the Rows area. Step three, drag Amount into the Values area. And just like that, Excel crunches all ten thousand rows and gives you a clean little summary showing total sales per store. You didn't write a formula. You didn't filter anything. You dragged two words into two boxes. Your boss thinks you're a genius.",
      "transition": "continuation",
      "clears": [],
