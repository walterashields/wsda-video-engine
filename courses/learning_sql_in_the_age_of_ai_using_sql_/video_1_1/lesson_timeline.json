    },
    {
      "id": "e04",
      "time_offset_ms": 71616,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "total_no_filter"
      },
      "narration": "Here's the query A-I gave you. SELECT SUM of amount FROM sales. That's it. No filter, no nothing. SUM is like dumping every receipt from the whole year into one pile and adding them up. Sounds fine, except you asked for Q four, and this query doesn't know that. It's grabbing everything.",
      "transition": "new_concept",
      "clears": [],
      "phases": []
    },
    {
      "id": "e04_pause",
      "time_offset_ms": 72516,
      "type": "pause",
