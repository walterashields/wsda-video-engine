    },
    {
      "id": "e09",
      "time_offset_ms": 146666,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "Look at this. Q one, two deals, twenty one thousand fifty. Q two, three deals, thirty thousand four hundred twenty five. Q three, three deals, twenty eight thousand seventy five. And Q four, four deals, eighty thousand eight hundred five. So your actual Q four number? Eighty thousand eight hundred five. That's about half the total you reported. You would've told your boss revenue was roughly double what it actually was. That's not great.",
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
