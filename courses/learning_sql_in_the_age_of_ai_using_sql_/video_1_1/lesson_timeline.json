      "clears": [],
      "phases": []
    },
    {
      "id": "e07",
      "time_offset_ms": 111933,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "where_clause_impact"
      },
      "narration": "Now here's the fix. We add a WHERE clause, think of it like a bouncer at the door. WHERE quarter equals Q four means only Q four receipts get into the pile. Everything else stays outside. And while we're at it, let's break it down by quarter so you can see exactly what each quarter contributed.",
      "transition": "new_concept",
      "clears": [
        "total_no_filter"
      ],
      "phases": []
    },
