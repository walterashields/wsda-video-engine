    },
    {
      "id": "e06",
      "time_offset_ms": 87600,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "There's your number. Looks legit. Feels legit. But this is every deal from Q one through Q four, all in one big pile. It's not what you asked for.",
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
