      "phases": []
    },
    {
      "id": "e16",
      "time_offset_ms": 307800,
      "type": "compare_results",
      "target": "sql_viewer",
      "params": {
        "targets": [
          "query_1",
          "query_2",
          "query_3",
          "query_4"
        ]
      },
      "narration": "Four queries. Two sources. One question asked two different ways across two different time windows. Query one and query two both ask about July. Monthly metrics says five percent. Churn events says one percent. Query three and query four both ask about Q3. Monthly metrics shows a declining trend across three months. Churn events gives a flat blended rate of three percent. None of these numbers are wrong in isolation. Each one is technically correct SQL against its source. The problem is that the sources measure different things, and nothing in this database tells you that. This is the AI-ready data design problem in its most consequential form. A real business decision was made on one of these numbers. The question for the next lesson is: what would have prevented it?",
      "transition": "emphasis",
      "clears": [],
      "phases": []
    },
