    {
      "id": "e15",
      "time_offset_ms": 241950,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "Five churn events for the full quarter. Rate of zero point zero three. Three percent blended across Q3. Compare that to monthly metrics, which showed rates between two and five percent by month. These two sources do not agree on the magnitude of the problem. They do not agree on the trend. And neither table has a single line of documentation explaining what it actually measures, how it is calculated, or when it was last updated. The AI had no way to know which one to use. It picked one. It returned a number. And that number went into a board presentation.",
      "transition": "emphasis",
      "clears": [],
      "phases": []
    },
    {
      "id": "e15_pause",
      "time_offset_ms": 242600,
      "type": "pause",
      "target": null,
