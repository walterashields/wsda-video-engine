      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e16_layout",
      "time_offset_ms": 251266,
      "type": "set_layout",
      "target": "sql_viewer",
      "params": {},
      "narration": "Let me put all four queries side by side so you can see the full scope of the problem.",
      "transition": "new_concept",
      "clears": [
        "result"
      ],
      "phases": []
    },
    {
      "id": "e16_pause",
      "time_offset_ms": 252166,
      "type": "pause",
      "target": null,
