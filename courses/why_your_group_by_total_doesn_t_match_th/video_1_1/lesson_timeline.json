      "time_offset_ms": 214649,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "scene2c_filter_gap_visible"
      },
      "narration": "Dashboards love hidden default filters, test accounts, internal orders, refunded transactions. They're baked in so deeply that nobody remembers they're there. This query pulls orders that a dashboard would typically exclude. Let's see who the offenders are.",
      "transition": "new_concept",
      "clears": [
