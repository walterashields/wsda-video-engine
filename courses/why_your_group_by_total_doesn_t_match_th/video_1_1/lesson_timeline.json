      "phases": []
    },
    {
      "id": "e08",
      "time_offset_ms": 138266,
      "type": "run_query",
      "target": "sql_viewer",
      "params": {
        "query_ref": "scene2a_inflated_join"
      },
      "narration": null,
      "transition": "new_concept",
      "clears": [],
      "phases": []
    },
    {
