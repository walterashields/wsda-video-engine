    },
    {
      "id": "e09",
      "time_offset_ms": 163750,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "There it is. The inflated count star gives us 19 rows and a total revenue of 1,125,150.75. That's way higher than the 765,060.25 we just saw. The join to shipments created extra rows, and SUM happily counted every duplicate. This is what's called fan-out, and it's the number one silent killer of accurate GROUP BY totals.",
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e09_pause",
      "time_offset_ms": 164200,
      "type": "pause",
