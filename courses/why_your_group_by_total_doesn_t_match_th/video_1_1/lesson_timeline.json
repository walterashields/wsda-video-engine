    },
    {
      "id": "e06",
      "time_offset_ms": 115100,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "Okay, look at this. Midwest comes in at 120,925.00. Northeast at 199,825.00. Southeast, 154,200.00. West is the big spender at 290,110.25. Grand total, 765,060.25. You'd feel great about this number, right? Except imagine your dashboard says something completely different for the same date range. Your stomach drops. Your instinct says the dashboard is wrong. Spoiler: it usually isn't. Let's figure out where this gap lives, starting with the most common culprit, something lurking in your FROM clause.",
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e06_pause",
      "time_offset_ms": 115550,
      "type": "pause",
