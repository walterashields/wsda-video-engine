      "phases": []
    },
    {
      "id": "e10",
      "time_offset_ms": 175583,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "scene2b_distinct_check"
      },
      "narration": "Here's the diagnostic query. We're comparing total rows to the count of distinct order IDs. This tells us exactly how many extra rows the join created.",
      "transition": "new_concept",
      "clears": [
        "scene2a_inflated_join"
      ],
      "phases": []
    },
    {
