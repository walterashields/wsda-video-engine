    },
    {
      "id": "e12",
      "time_offset_ms": 198233,
      "type": "show_result",
      "target": "sql_viewer",
      "params": {},
      "narration": "19 total rows, but only 14 distinct orders. That's 5 extra rows the join invented. Five rows that inflated your SUM without leaving a trace. The fix? Either aggregate before you join, or use DISTINCT carefully. But now let's tackle cause number two, filter gaps.",
      "transition": "continuation",
      "clears": [],
      "phases": []
    },
    {
      "id": "e12_pause",
      "time_offset_ms": 198683,
      "type": "pause",
