      "clears": [],
      "phases": []
    },
    {
      "id": "e07",
      "time_offset_ms": 136516,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "scene2a_inflated_join"
      },
      "narration": "Cause number one: duplicate rows from joins. Here we're joining orders to the shipments table and counting all rows with COUNT star, plus summing the total revenue. If an order shipped in multiple packages, it'll appear once per shipment. Your SUM inflates silently. Nobody warns you. Let's run it.",
      "transition": "new_concept",
      "clears": [
        "scene1_group_by_total"
      ],
      "phases": []
    },
    {
      "id": "e07_pause",
      "time_offset_ms": 137416,
      "type": "pause",
      "target": null,
