      "time_offset_ms": 79116,
      "type": "highlight_section",
      "target": "sql_viewer",
      "params": {
        "section": "scene1_group_by_total"
      },
      "narration": "Let's start by reproducing the mismatch. This query groups orders by region and sums up the gross revenue. Simple stuff, the kind of query you'd write in thirty seconds. Let's see what it gives us.",
      "transition": "new_concept",
      "clears": [],
